{
  "title": "Slack",
  "description": "RJSF form schema for creating a Slack credential. Captures the user-input fields of the canonical Credential construct; the `secret` object is the type-specific shape persisted under the canonical free-form `secret` map. Field shape, types, enums, and required list MUST stay a subset of meshery/schemas/constructs/v1beta1/credential/api.yml#/components/schemas/Credential; the Go validator at validation/forms_test.go enforces that.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Credential Name",
      "description": "Human-readable name for the credential."
    },
    "secret": {
      "type": "object",
      "title": "Credential Secret",
      "description": "Credential secret for the Slack app",
      "properties": {
        "SLACK_APP_ID": {
          "type": "string",
          "title": "App ID",
          "description": "Slack app ID"
        },
        "SLACK_CLIENT_ID": {
          "type": "string",
          "title": "Client ID",
          "description": "Slack app client ID"
        },
        "SLACK_BOT_TOKEN": {
          "type": "string",
          "title": "Bot Token",
          "description": "Slack bot token",
          "writeOnly": true
        },
        "SLACK_CLIENT_SECRET": {
          "type": "string",
          "title": "Client Secret",
          "description": "Slack app client secret",
          "writeOnly": true
        },
        "SLACK_SIGNING_SECRET": {
          "type": "string",
          "title": "Signing Secret",
          "description": "Slack app signing secret",
          "writeOnly": true
        },
        "SLACK_USER_TOKEN": {
          "type": "string",
          "title": "User Token",
          "description": "Slack user token",
          "writeOnly": true
        },
        "SLACK_VERIFICATION_TOKEN": {
          "type": "string",
          "title": "Verification Token",
          "description": "Slack verification token",
          "writeOnly": true
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
